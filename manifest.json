{
  "manifest_version": 3,
  "name": "Foco — bloqueador de vídeos curtos",
  "short_name": "Foco",
  "version": "1.0.0",
  "description": "Um botão só: liga o foco e some com Shorts, Reels e TikTok.",
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.instagram.com/*",
    "*://*.tiktok.com/*",
    "*://*.facebook.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Foco",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.instagram.com/*",
        "*://*.tiktok.com/*",
        "*://*.facebook.com/*"
      ],
      "js": ["content/content.js"],
      "css": ["content/block.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
